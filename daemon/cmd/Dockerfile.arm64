# Stage 1: Build Rust daemon for aarch64
FROM rust:1.87-bookworm AS builder
RUN apt-get update && apt-get install -y musl-tools gcc-aarch64-linux-gnu && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY Cargo.toml ./
COPY crates/ crates/
RUN rustup target add aarch64-unknown-linux-musl && \
    CARGO_TARGET_AARCH64_UNKNOWN_LINUX_MUSL_LINKER=aarch64-linux-gnu-gcc \
    cargo build --release --target aarch64-unknown-linux-musl -p ix-server && \
    cp target/aarch64-unknown-linux-musl/release/ixd /ixd

# Stage 2: Base image
FROM ubuntu:24.04 AS base

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates curl git jq ripgrep fd-find unzip \
    python3 python3-pip python3-venv \
    libatomic1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.2 /uv /usr/local/bin/uv

# Node.js via fnm (mirrors the x86_64 base stage — see Dockerfile for why the
# /usr/local/bin symlinks are required for the JS REPL inside VMs)
ENV FNM_DIR=/root/.local/share/fnm
ENV PATH="/root/.local/share/fnm:${PATH}"
RUN curl -fsSL https://fnm.vercel.app/install | bash -s -- --install-dir /root/.local/share/fnm --skip-shell && \
    eval "$(fnm env)" && \
    fnm install 25 && \
    fnm default 25 && \
    export PATH="/root/.local/share/fnm/aliases/default/bin:$PATH" && \
    npm install -g pnpm && \
    ln -sf /root/.local/share/fnm/aliases/default/bin/node /usr/local/bin/node && \
    ln -sf /root/.local/share/fnm/aliases/default/bin/npm /usr/local/bin/npm && \
    ln -sf /root/.local/share/fnm/aliases/default/bin/npx /usr/local/bin/npx
ENV PATH="/root/.local/share/fnm/aliases/default/bin:${PATH}"
ENV PNPM_HOME=/root/.local/share/pnpm
ENV PATH="${PNPM_HOME}:${PNPM_HOME}/bin:${PATH}"

COPY --from=builder /ixd /usr/local/bin/ixd

WORKDIR /workspace
EXPOSE 8080
CMD ["ixd"]
