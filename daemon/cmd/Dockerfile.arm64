# Stage 1: Build Rust daemon for aarch64
FROM rust:1.87-bookworm AS builder
RUN apt-get update && apt-get install -y musl-tools gcc-aarch64-linux-gnu && rm -rf /var/lib/apt/lists/*
WORKDIR /src
# Cargo.lock is required, for the reason spelled out in cmd/Dockerfile: without
# it every build re-resolves the graph and tracks crates.io instead of what was
# tested. No CI job builds this file, so it fails only in someone's hands.
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
RUN rustup target add aarch64-unknown-linux-musl && \
    CARGO_TARGET_AARCH64_UNKNOWN_LINUX_MUSL_LINKER=aarch64-linux-gnu-gcc \
    cargo build --locked --release --target aarch64-unknown-linux-musl -p ix-server && \
    cp target/aarch64-unknown-linux-musl/release/ixd /ixd

# Stage 2: Base image
FROM ubuntu:24.04 AS base

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates curl git jq ripgrep fd-find unzip \
    python3 python3-pip python3-venv \
    libatomic1 xz-utils \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.2 /uv /usr/local/bin/uv

# Node.js — pinned tarball straight from nodejs.org into /usr/local
# (mirrors the x86_64 base stage — see Dockerfile for the full rationale)
ARG NODE_VERSION=25.1.0
RUN curl -fsSL --retry 3 "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-arm64.tar.xz" \
      | tar -xJ -C /usr/local --strip-components=1 \
    && node --version && npm --version \
    && npm install -g pnpm
ENV PNPM_HOME=/root/.local/share/pnpm
ENV PATH="${PNPM_HOME}:${PNPM_HOME}/bin:${PATH}"

COPY --from=builder /ixd /usr/local/bin/ixd

WORKDIR /workspace
EXPOSE 8080
CMD ["ixd"]
